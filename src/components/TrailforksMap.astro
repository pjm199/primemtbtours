---
// TrailforksMap component - Interactive Trailforks region map with featured trails
import TrailCard from "./TrailCard";
import type { TrailCardProps } from "./TrailCard";
---

<section class="w-full bg-linear-to-b from-[#0f172a] via-[#1e3a8a] to-[#0f172a] py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Explore Liguria MTB Regions</h2>
    <p class="text-gray-400 mb-8">
      Switch region and style to see the <strong class="text-white">Trailforks Region Map</strong>
      and discover the most iconic trails in each area.
    </p>

    <div class="bg-slate-900/60 backdrop-blur-sm rounded-2xl p-6 md:p-8 shadow-2xl border border-blue-500/20">
      <!-- Region Buttons -->
      <div class="flex flex-wrap gap-3 mb-6" id="region-buttons">
        <!-- Buttons will be generated by JavaScript -->
      </div>

      <!-- Map Container -->
      <div class="rounded-xl overflow-hidden border border-slate-700 bg-slate-950 mb-4 max-w-full mx-auto" style="aspect-ratio:1.618/1; width:100%; max-width:1000px;">
        <iframe
          id="tf-map"
          title="Trailforks Region Map"
          class="w-full h-full border-0"
          style="aspect-ratio:1.618/1; width:100%; height:100%; min-height:380px; max-width:1000px;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <!-- Map Footer -->
      <div class="flex flex-wrap gap-4 justify-between text-xs text-gray-400 mb-8">
        <span id="region-description"></span>
        <span>
          Data by <a href="https://www.trailforks.com/" target="_blank" rel="noreferrer" class="text-[#00a8e1] hover:underline">Trailforks</a>.
        </span>
      </div>

      <!-- Featured Trails Header -->
      <div class="flex justify-between items-baseline mb-6">
        <h3 class="text-xl font-bold text-white">Featured trails in <span id="region-name-inline">Sestri Levante</span></h3>
        <span class="text-xs text-gray-400 hidden sm:block">Handpicked iconic lines</span>
      </div>

      <!-- Trail Cards Grid -->
      <div id="trail-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </div>
  </div>
</section>

<script>
  import { createRoot } from 'react-dom/client';
  import { createElement } from 'react';
  import TrailCard from './TrailCard';
  import type { TrailCardProps } from './TrailCard';

  // Region configuration with featured trails
  const REGIONS: Array<{
    id: number;
    label: string;
    url: string;
    note: string;
    defaultZoom: number;
    featuredTrails: TrailCardProps[];
  }> = [
    {
      id: 12424,
      label: "Sestri Levante",
      url: "https://www.trailforks.com/region/sestri-levante/",
      note: "Iconic enduro trails dropping straight to the sea.",
      defaultZoom: 13,
      featuredTrails: [
        {
          title: "Mimosa",
          area: "Sestri Levante",
          difficulty: "Expert",
          length: "8 km",
          typeTag: "Enduro",
          elevation: "650m↓",
          description: "Famous Ligurian descent with sea views, varied terrain and technical sections."
        },
        {
          title: "Ca Gianca",
          area: "Sestri Levante",
          difficulty: "Advanced",
          length: "6 km",
          typeTag: "Technical",
          elevation: "550m↓",
          description: "Steep technical line with rock steps, tight switchbacks and challenging terrain."
        },
        {
          title: "Motocarriole",
          area: "Sestri Levante",
          difficulty: "Intermediate",
          length: "7 km",
          typeTag: "Flow",
          elevation: "480m↓",
          description: "Natural forest singletrack with flowing sections and panoramic glimpses."
        }
      ]
    },
    {
      id: 26205,
      label: "Cinque Terre",
      url: "https://www.trailforks.com/region/cinque-terre-26205/",
      note: "Ridge lines and sanctuaries above the famous villages.",
      defaultZoom: 12,
      featuredTrails: [
        {
          title: "Alta Via 5 Terre",
          area: "Cinque Terre",
          difficulty: "Intermediate",
          length: "18 km",
          typeTag: "Scenic",
          elevation: "850m↓",
          description: "High ridge route with constant sea views linking villages from above."
        },
        {
          title: "Strada dei Santuari",
          area: "Cinque Terre",
          difficulty: "Intermediate",
          length: "15 km",
          typeTag: "E-Bike",
          elevation: "720m↓",
          description: "Historic pilgrim path between sanctuaries, perfect for e-MTB tours."
        },
        {
          title: "Trail 502",
          area: "Cinque Terre",
          difficulty: "Beginner",
          length: "10 km",
          typeTag: "XC",
          elevation: "580m↓",
          description: "Forest connector with mixed terrain and beautiful viewpoints."
        }
      ]
    },
    {
      id: 11940,
      label: "Genova Righi",
      url: "https://www.trailforks.com/region/genova-1656/",
      note: "City trails with stunning views over Genova and the port.",
      defaultZoom: 13,
      featuredTrails: [
        {
          title: "Forte Diamante",
          area: "Genova Righi",
          difficulty: "Expert",
          length: "9 km",
          typeTag: "Enduro",
          elevation: "680m↓",
          description: "Technical descent from historic fort with stunning city and port views."
        },
        {
          title: "Righi Flow",
          area: "Genova Righi",
          difficulty: "Intermediate",
          length: "7 km",
          typeTag: "Flow",
          elevation: "550m↓",
          description: "Fast flowing trail above the city, popular with all skill levels."
        },
        {
          title: "Bellavista",
          area: "Genova Righi",
          difficulty: "Intermediate",
          length: "8 km",
          typeTag: "Scenic",
          elevation: "620m↓",
          description: "Mix of technical and flow sections with panoramic Genova views."
        }
      ]
    }
  ];

  const $regionButtons = document.getElementById("region-buttons") as HTMLElement;
  const $iframe = document.getElementById("tf-map") as HTMLIFrameElement;
  const $regionDesc = document.getElementById("region-description") as HTMLElement;
  const $regionNameInline = document.getElementById("region-name-inline") as HTMLElement;
  const $trailCardsContainer = document.getElementById("trail-cards-container") as HTMLElement;

  let currentRegionIndex = 0;
  let reactRoot: any = null;

  // Create region buttons
  function createButtons() {
    $regionButtons.innerHTML = REGIONS.map((region, idx) => `
      <button
        class="px-6 py-3 rounded-lg font-semibold text-sm transition-all duration-300 ${
          idx === 0
            ? 'bg-linear-to-r from-[#00a8e1] to-[#00d4ff] text-white shadow-lg shadow-[#00a8e1]/30 scale-105'
            : 'bg-slate-800/60 text-gray-300 hover:bg-slate-700/80 hover:text-white border border-slate-600/50'
        }"
        data-region-index="${idx}"
      >
        ${region.label}
      </button>
    `).join('');

    // Add click listeners
    $regionButtons.querySelectorAll('button').forEach(button => {
      button.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const index = parseInt(target.dataset.regionIndex || '0');
        currentRegionIndex = index;
        updateButtons();
        updateMap();
      });
    });
  }

  function updateButtons() {
    $regionButtons.querySelectorAll('button').forEach((button, idx) => {
      const isActive = idx === currentRegionIndex;
      button.className = `px-6 py-3 rounded-lg font-semibold text-sm transition-all duration-300 ${
        isActive
          ? 'bg-linear-to-r from-[#00a8e1] to-[#00d4ff] text-white shadow-lg shadow-[#00a8e1]/30 scale-105'
          : 'bg-slate-800/60 text-gray-300 hover:bg-slate-700/80 hover:text-white border border-slate-600/50'
      }`;
    });
  }

  function buildRegionMapSrc({ rid, zoom }: { rid: number; zoom: number }) {
    const params = new URLSearchParams({
      rid: String(rid),
      activitytype: "1",
      w: "1000",
      h: "618",
      maptype: "trailforks",
      trailstyle: "difficulty",
      controls: "1",
      list: "0",
      basicmap: "0",
      layers: "trail,labels,poi",
      hideunsanctioned: "1",
      z: String(zoom),
      lat: "",
      lon: ""
    });
    return "https://www.trailforks.com/widgets/region_map/?" + params.toString();
  }

  function renderTrailCards(region: typeof REGIONS[0]) {
    // Clear previous React root if it exists
    if (reactRoot) {
      reactRoot.unmount();
      reactRoot = null;
    }

    // Create React Fragment with trail cards
    const cards = region.featuredTrails.map(trail =>
      createElement(TrailCard, { key: trail.title, ...trail })
    );

    // Create or reuse React root
    if (!reactRoot) {
      reactRoot = createRoot($trailCardsContainer);
    }

    reactRoot.render(cards);
  }  function updateMap() {
    const region = REGIONS[currentRegionIndex];
    const rid = region.id;
    const zoom = region.defaultZoom ?? 12;

    const src = buildRegionMapSrc({ rid, zoom });
    $iframe.src = src;

    $regionDesc.innerHTML =
      `<strong class="text-white">${region.label}</strong> – ${region.note} &nbsp;` +
      `<a href="${region.url}" target="_blank" rel="noreferrer" class="text-[#00a8e1] hover:underline">Trailforks region »</a>`;
    $regionNameInline.textContent = region.label;
    renderTrailCards(region);
  }

  // Initial load
  createButtons();
  updateMap();
</script>
