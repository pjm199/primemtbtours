---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour: CollectionEntry<'tours'>) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

interface Props {
  tour: CollectionEntry<'tours'>;
}

const { tour } = Astro.props as Props;
const { Content } = await tour.render();

const difficultyColors: Record<string, string> = {
  Beginner: "from-green-500 to-emerald-600",
  Intermediate: "from-amber-500 to-orange-600",
  Advanced: "from-red-500 to-rose-600",
};

const categoryColors: Record<string, string> = {
  Scenic: "bg-blue-500",
  Enduro: "bg-red-500",
  "E-MTB": "bg-green-500",
  Custom: "bg-purple-500",
};
---

<Layout
  title={`${tour.data.title} | Prime MTB Tours`}
  description={tour.data.description}
  image={tour.data.image}
  canonical={`/tours/${tour.slug}`}
>
  <article class="min-h-screen bg-[#0f172a] text-white">
    <!-- Hero Section -->
    <div class="relative h-[60vh] min-h-[400px]">
      <img
        src={tour.data.image}
        alt={tour.data.title}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-linear-to-t from-[#0f172a] via-slate-900/60 to-transparent"></div>

      <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12">
        <div class="max-w-4xl mx-auto">
          <!-- Category & Difficulty Badges -->
          <div class="flex flex-wrap gap-2 mb-4">
            <span class={`px-3 py-1 rounded-full text-xs font-bold text-white ${categoryColors[tour.data.category]}`}>
              {tour.data.category}
            </span>
            <span class={`px-3 py-1 rounded-full text-xs font-bold text-white bg-gradient-to-r ${difficultyColors[tour.data.difficulty]}`}>
              {tour.data.difficulty}
            </span>
          </div>

          <h1 class="text-4xl md:text-6xl font-bold mb-4">{tour.data.title}</h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-6">{tour.data.subtitle}</p>

          <!-- Quick Info -->
          <div class="flex flex-wrap gap-6 text-sm md:text-base">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-[#00a8e1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{tour.data.duration}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-[#00a8e1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-[#00a8e1] font-bold text-lg">{tour.data.price}</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-[#00a8e1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span>{tour.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Section -->
    <div class="max-w-4xl mx-auto px-6 md:px-12 py-12">
      <!-- Highlights -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold mb-4 text-[#00a8e1]">Highlights</h2>
        <div class="flex flex-wrap gap-2">
          {tour.data.highlights.map((highlight: string) => (
            <span class="px-4 py-2 bg-white/10 rounded-lg text-sm">
              ✓ {highlight}
            </span>
          ))}
        </div>
      </div>

      <!-- Main Content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <Content />
      </div>

      <!-- CTA Section -->
      <div class="mt-12 p-8 bg-gradient-to-r from-[#00a8e1]/20 to-cyan-500/20 rounded-lg border border-[#00a8e1]/30">
        <h3 class="text-2xl font-bold mb-4">Ready to Book This Tour?</h3>
        <p class="text-gray-300 mb-6">Join us for an unforgettable mountain biking experience on the Italian Riviera.</p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="px-8 py-3 bg-[#00a8e1] text-white font-bold rounded-lg hover:bg-cyan-400 transition-all"
          >
            Book Now
          </a>
          <a
            href="/tours"
            class="px-8 py-3 bg-white/10 text-white font-bold rounded-lg hover:bg-white/20 transition-all"
          >
            View All Tours
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Prose styling for markdown content */
  .prose h2 {
    color: #00a8e1;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: #fff;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  .prose ul, .prose ol {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: #00a8e1;
  }

  .prose img {
    border-radius: 0.5rem;
    margin: 2rem 0;
  }
</style>
